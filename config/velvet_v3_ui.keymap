#include "keys_ru.h"
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt { quick-tap-ms = <190>; };

&lt { quick-tap-ms = <190>; };

/ {
    behaviors {
        cap_sen: cap_sen {
            compatible = "zmk,behavior-hold-tap";
            label = "CAP_SEN";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-while-undecided;
        };

        mouse_layer: mouse_layer {
            compatible = "zmk,behavior-sticky-key";
            label = "MOUSE_LAYER";
            bindings = <&mo>;
            #binding-cells = <1>;
            release-after-ms = <200>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "MT1";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <190>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        zip_auto_mouse: zip_auto_mouse {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
            require-prior-idle-ms = <800>;
            excluded-positions = <>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cmb1 {
            bindings = <&kp RIGHT_GUI>;
            key-positions = <8 9>;
        };

        CMB2 {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <20 21>;
        };

        CMB3 {
            bindings = <&kp LGUI>;
            key-positions = <3 2>;
        };

        CMB4 {
            bindings = <&kp LEFT_ALT>;
            key-positions = <14 15>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp GRAVE  &kp Q  &kp W               &kp E              &kp R                &kp T                                &kp Y            &kp U  &kp I      &kp O        &kp P      &kp RGUI
&lt 3 TAB  &kp A  &kp S               &kp D              &kp F                &kp G                                &kp H            &kp J  &kp K      &kp L        &kp SEMI   &kp BSLH
&none      &kp Z  &kp X               &kp C              &kp V                &kp B                                &kp N            &kp M  &kp COMMA  &kp DOT      &kp SLASH  &none
                  &lt 8 LEFT_BRACKET  &kp RIGHT_BRACKET  &mt LSHFT BACKSPACE  &lt 1 ESC  &kp LCTRL    &lt 2 ENTER  &mt RSHFT SPACE  &none  &kp MINUS  &lt 8 EQUAL
            >;

            display-name = "Base";
        };

        nav {
            bindings = <
&kp ESC  &kp LG(LEFT_ARROW)  &kp LA(W)         &kp LG(DOWN_ARROW)  &kp LG(UP)  &kp LG(RIGHT_ARROW)                  &kp PG_UP   &kp PAGE_DOWN  &kp UP         &kp LA(O)        &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES
&kp TAB  &kp LG(HOME)        &none             &kp LC(C)           &kp LC(V)   &none                                &kp HOME    &kp LEFT       &kp DOWN       &kp RIGHT_ARROW  &none             &none
&none    &none               &kp LA(X)         &kp LG(C)           &kp LG(V)   &kp LA(TAB)                          &kp END     &kp LG(M)      &kp LG(COMMA)  &kp LC(DOT)      &kp LG(SLASH)     &none
                             &kp LEFT_BRACKET  &kp RIGHT_BRACKET   &none       &mo 7                &none    &mo 7  &kp DELETE  &trans         &none          &none
            >;

            display-name = "Navigation";
        };

        sym {
            bindings = <
&none  &kp CARET        &kp AMPERSAND     &kp ASTRK          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                  &none   &none           &kp UP_ARROW    &none            &none      &kp F12
&mo 3  &kp EXCLAMATION  &kp AT            &kp HASH           &kp DLLR              &kp PERCENT                            &none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LA(G)  &kp LA(PERCENT)
&none  &kp UNDER        &kp MINUS         &kp EQUAL          &kp PLUS              &none                                  &kp AT  &kp PIPE        &kp TILDE       &kp AMPS         &trans     &trans
                        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BSPC              &mo 7                  &none    &none  &none   &trans          &none           &none
            >;

            display-name = "Symbols";
        };

        adj {
            bindings = <
&none  &none  &none  &none  &kp LEFT_ALT     &kp RIGHT_ALT                         &none         &none           &mmv MOVE_UP    &kp LC(LEFT_ARROW)  &kp LC(RIGHT_ARROW)  &kp LC(UP_ARROW)
&none  &none  &none  &none  &msc MOVE_Y(10)  &none                                 &kp LC(HOME)  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT     &kp LA(LEFT_ARROW)   &kp LA(RIGHT_ARROW)
&none  &none  &none  &none  &none            &none                                 &kp LC(END)   &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_DOWN      &mmv MOVE_RIGHT      &none
              &none  &none  &mkp MB3         &mkp MB1       &mkp MB2    &kp ENTER  &none         &none           &kp LG(TAB)     &kp LG(GRAVE)
            >;

            display-name = "Adjust";
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &none   &none   &none   &mo 5     &mo 6                         &none   &none   &none   &none   &none   &trans
&trans  &trans  &trans  &trans  &trans    &trans                        &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &mkp MB3  &mkp MB1  &mkp MB2    &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Mouse";
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &mkp MB1                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans                        &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &mkp MB3  &mkp MB1  &mkp MB2    &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Scroll";
        };

        sniper {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans                        &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &mkp MB3  &mkp MB1  &mkp MB2    &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Sniper";
        };

        User0 {
            bindings = <
&kp COLON  &kp F1    &kp F2            &kp F3             &kp F4          &kp F5                        &kp F6        &kp F7         &kp LG(TAB)   &kp LG(LC(LEFT_ARROW))  &kp LG(LC(RIGHT_ARROW))  &kp LC(UP)
&kp TAB    &kp N1    &kp NUMBER_2      &kp NUMBER_3       &kp NUMBER_4    &kp NUMBER_5                  &kp NUMBER_6  &kp NUMBER_7   &kp NUMBER_8  &kp NUMBER_9            &kp NUMBER_0             &kp DOT
&none      &kp EXCL  &kp AT            &kp HASH           &kp LS(DOLLAR)  &kp PERCENT                   &kp CARET     &kp AMPERSAND  &kp ASTERISK  &kp LPAR                &kp RPAR                 &none
                     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BSPC        &none         &none    &none  &kp SPACE     &trans         &kp MINUS     &kp EQUAL
            >;

            display-name = "User0";
        };

        User1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL
&trans  &trans  &trans  &trans  &trans  &trans                    &out OUT_BLE  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans                    &out OUT_USB  &trans        &trans        &trans        &trans        &trans
                &trans  &mo 9   &trans  &trans  &trans    &trans  &trans        &trans        &mo 9         &trans
            >;

            display-name = "User1";
        };

        User2 {
            bindings = <
&trans  &trans  &bootloader  &bootloader  &trans  &trans                    &trans  &trans  &bootloader  &bootloader  &trans  &trans
&trans  &trans  &trans       &trans       &trans  &trans                    &trans  &trans  &trans       &trans       &trans  &trans
&trans  &trans  &trans       &trans       &trans  &trans                    &trans  &trans  &trans       &trans       &trans  &trans
                &trans       &trans       &trans  &trans  &trans    &trans  &trans  &trans  &trans       &trans
            >;

            display-name = "User2";
        };

        User3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "User3";
        };
    };
};

&trackball { cpi = <1000>; };
